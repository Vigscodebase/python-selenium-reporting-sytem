                <p>Please check the report to review the campaign performance in the following link: <a href="%s">Get Report Here</a></p>
                <p>Kindly confirm receipt of these reports. I am available to discuss this monthly 
                report next week if you have any doubts or queries.</p>

                <p>Thanks</p>
            ''' % (client_name,domain,url)

        return subject,email_content
    
    
    def create_admin_email_content(self,overall):

        today = date.today()
        year = int(today.year)
        month = int(today.month)
        day = int(today.day)

        report_date = "%s-%s-%s" % ('{:02d}'.format(day),'{:02d}'.format(month),year)

        subject = "Clickmatix Report Delivery Summary for %s" % report_date

        table = self.__generate_table(overall)

        email_content = ''' 
            <p>Hello Admin,</p>
            <p>Hope you are doing well.</p>
            <p>Here we are sharing the Campaign Performance report for the last (30 days) to give you an understanding of current performance.</p>

            <p>The report will help you to understand the following performance:</p>
            %s

            <p>Please check the report to review the campaign performance in the following link</p>
            <p>Kindly confirm receipt of these reports. I am available to discuss this monthly 
            report next week if you have any doubts or queries.</p>

            <p>Thanks</p>
            ''' % table
        
        return subject,email_content

    def __generate_table(self,overall):
        table_st = '''<table border="1">
                        <thead>
                            <tr>
                                <td>Domain Name</td>
                                <td>Process Status</td>
                                <td>Message</td>
                                <td>URL</td>
                            </tr>
                        </thead>
                        <tbody>'''

        body = ""

        for record in overall:
            tr_start = "<tr>"
            td_st = "<td>"
            td_end = "</td>"
            tr_end = "</tr>"

            client_info =  overall[record]
            r_status = client_info["status"]
            message = client_info["message"]

            if r_status:
                status = "<p style='color:green'>Sent</p>"
            else:
                status = "<p style='color:red'>Failed</p>"
            body =  body + tr_start + td_st + record + td_end
            body =  body + td_st + str(status) + td_end
            body =  body + td_st + message + td_end

            if "url" in client_info.keys():
                url = client_info["url"]
                body =  body + td_st + url + td_end + tr_end
            else:
                body = body + tr_end
        
        table_end = '''</tbody></table>'''

        table = table_st + body + table_end
        return table
    






