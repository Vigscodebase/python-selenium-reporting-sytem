import smtplib
from email.mime.text import MIMEText
from email import encoders
from email.mime.base import MIMEBase
from email.mime.multipart import MIMEMultipart

from utils.logging import *
from datetime import date, timedelta, datetime

class EmailService():

    @staticmethod
    def get_date_range(today):
        """
        params: today: datetime.date object
        returns previous month and current month in this format:
        For example: 
        Feb'23 - Mar'23
        Dec'22 - Jan'23
        """
        this_month = datetime.strftime(today, "%b'%y")
        last_month = datetime.strftime(today.replace(day=1) - timedelta(days=1), "%b'%y")
        return last_month + ' - ' + this_month

    def send_email(self,subject, content, email_to,ccs=[],bcc=[],file_name=None,attachment=None):

        log.debug("Variables for email %s, %s, %s,%s,%s,%s" % (subject,content,email_to,ccs,file_name,attachment))
        #GET SMTP Details

        sender_name = SENDER_NAME
        server = SERVER
        port = PORT
        username = USERNAME
        password = PASSWORD

        status = False

        try:
            # Reference: https://wpmailsmtp.com/gmail-less-secure-apps/#Option_2_Use_an_App_Password
            if attachment and file_name:
                file_name = ''.join(file_name.split())
                message = MIMEMultipart()
                # Turn these into plain/html MIMEText objects
                part1 = MIMEText(content, "html")

                # Add body to email
                message.attach(part1)

                with open(attachment, "rb") as attachment:
                    # Add file as application/octet-stream
                    # Email client can usually download this automatically as attachment
                    part = MIMEBase("application", "octet-stream")
                    part.set_payload(attachment.read())
                
                # Encode file in ASCII characters to send by email    
                encoders.encode_base64(part)

                # Add header as key/value pair to attachment part
                log.info("FileName %s" % file_name)
                part.add_header(
                    "Content-Disposition",
                    f"attachment; filename= {file_name}"
                )

                # Add attachment to message and convert message to string
                message.attach(part)
            else:
                message = MIMEText(content,"html")

            message['From'] = sender_name
            message['To'] = ",".join(email_to)
            message['Subject'] = subject
            message['CC'] = ",".join(ccs)
            message['CCC'] = ",".join(bcc)

            log.debug("Message to be sent: %s" % message)

            session = smtplib.SMTP(server,port)
            session.starttls()
            session.login(username,password)
            
            email_to_all = email_to + ccs + bcc
            text = message.as_string()
            session.sendmail(username,email_to_all,text)
            session.quit()
            log.info("Email succesfully sent to %s" % email_to)
            status = True
        except Exception as e:
            log.error("Email could not be sent to %s" % email_to)
            log.error(e)

        return status
    
    def create_client_email_content(self,domain,client_name,url,report_day,report_type):
